@model List<MYAcademy_Portfolio.Entities.Experience>
@{
    ViewData["Title"] = "ExperienceList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Alt Başlık</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>Sil</th>
            <th>Güncelle</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExperienceId</td>
                <td>@item.Title</td>
                <td>@item.SideTitle</td>
                <td>@item.Duration</td>

                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pasif</span>
                    }
                </td>

                <td>
                    <form asp-area="Admin"
                          asp-controller="Experience"
                          asp-action="DeleteExperience"
                          method="post">

                        <input type="hidden" name="id" value="@item.ExperienceId" />

                        <button type="submit" class="btn btn-danger">
                            Sil
                        </button>
                    </form>
                </td>
                <td>
                    <a href="/Admin/Experience/UpdateExperience/@item.ExperienceId"
                       class="btn btn-success">
                        Güncelle
                    </a>
                </td>
            </tr>
        }


    </table>

</div>
