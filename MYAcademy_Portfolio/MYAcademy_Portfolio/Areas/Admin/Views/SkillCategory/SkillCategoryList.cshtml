@model List<MYAcademy_Portfolio.Entities.SkillCategory>

@{
    ViewData["Title"] = "Yetenek Kategorileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<h2 class="mb-4">Yetenek Kategorileri</h2>

<a asp-area="Admin"
   asp-controller="SkillCategory"
   asp-action="CreateSkillCategory"
   class="btn btn-primary mb-3">
    + Yeni Kategori Ekle
</a>

<div class="card">
    <div class="card-body">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Sıra</th>
                    <th>Kategori Adı</th>
                    <th>Açıklama</th>
                    <th>İkon</th>
                    <th>Renk</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DisplayOrder</td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Icon))
                                {
                                    <i class="bi @item.Icon"></i>
                                    <span class="ms-1">@item.Icon</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Color))
                                {
                                    <span class="badge border text-dark" style="background-color:@item.Color;">
                                        @item.Color
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-area="Admin"
                                       asp-controller="SkillCategory"
                                       asp-action="UpdateSkillCategory"
                                       asp-route-id="@item.SkillCategoryId"
                                       class="btn btn-success btn-sm">
                                        Güncelle
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="SkillCategory"
                                          asp-action="DeleteSkillCategory"
                                          asp-route-id="@item.SkillCategoryId"
                                          method="post"
                                          onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            Henüz yetenek kategorisi eklenmemiş.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["Error"]
            </div>
        }
    </div>
</div>